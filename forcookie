    if not ProfileData or not ProfileData[Type] then return false end
    local Owned = ProfileData[Type].Owned
    for Index, Value in pairs(Owned) do
        if Index == ItemName then return true, Value end
        if Value == ItemName then return true, 1 end
    end
    return false
end

local function GiveItem(ItemName, Amount, ItemType)
    if not ProfileData then return end
    pcall(function()
        if ProfileData[ItemType].Owned[ItemName] == nil then
            ProfileData[ItemType].Owned[ItemName] = Amount
        else
            ProfileData[ItemType].Owned[ItemName] = ProfileData[ItemType].Owned[ItemName] + Amount
        end
        -- 🆕 безопасный вызов
        if ItemPopupService and ItemPopupService.ItemReceived and type(ItemPopupService.ItemReceived.Fire) == "function" then
            pcall(function() ItemPopupService.ItemReceived:Fire(ItemName, ItemType) end)
        end
        game.ReplicatedStorage.Remotes.Inventory.InventoryDataChanged:Fire()
    end)
end

local function RemoveItem(ItemName, Amount, ItemType)
    if not ProfileData then return end
    pcall(function()
        local owned = ProfileData[ItemType].Owned[ItemName]
        if not owned then return end
        if owned - Amount > 0 then
            ProfileData[ItemType].Owned[ItemName] = owned - Amount
        else
            ProfileData[ItemType].Owned[ItemName] = nil
        end
        -- 🆕 синхронизация с фейковым инвентарём
        if myFakeInventory and myFakeInventory[ItemType] and myFakeInventory[ItemType].Owned then
            local fake = myFakeInventory[ItemType].Owned[ItemName]
            if fake then
                local nv = fake - Amount
                if nv > 0 then
                    myFakeInventory[ItemType].Owned[ItemName] = nv
                else
                    myFakeInventory[ItemType].Owned[ItemName] = nil
                end
            end
        end
        game.ReplicatedStorage.Remotes.Inventory.InventoryDataChanged:Fire()
    end)
end

