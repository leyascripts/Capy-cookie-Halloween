-- 🔁 Алиасы ключей (обычная таблица, БЕЗ __mode — иначе GC съест ключи)
local SPAWN_ALIASES = {}
SPAWN_ALIASES.Corrupt = "Sorry"

-- 🔁 Резолвер ключа
local function resolveKey(k)
    if not k then return k end
    local v = SPAWN_ALIASES[k]
    if v then return v end
    return k
end

-- 🛡 Защита от nil, чтобы SpawnItem не упал на индексации
BlockedWeaponKeys = BlockedWeaponKeys or {}

-- 🎁 Спавн предмета
local function SpawnItem(ItemName, Amount, ItemType)
    if not ProfileData then return end
    if ItemName == nil then return end

    ItemName = resolveKey(ItemName)                 -- 🔁 Corrupt → Sorry
    Amount   = Amount   or 1
    ItemType = ItemType or "Weapons"

    if ItemType == "Weapons" and BlockedWeaponKeys[ItemName] then return end
    -- 🆕 страховка: не спавним трофеи/исключённое (Corrupt/Sorry проходят)
    if ItemType == "Weapons" and isExcludedItem(ItemName) then return end

    pcall(function()
        ProfileData[ItemType].Owned[ItemName] =
            (ProfileData[ItemType].Owned[ItemName] or 0) + Amount
        game.ReplicatedStorage.Remotes.Inventory.InventoryDataChanged:Fire()
    end)

    -- 🎭 обновить фейковый инвентарь для своего профиля
    if myFakeInventory and myFakeInventory[ItemType] and myFakeInventory[ItemType].Owned then
        myFakeInventory[ItemType].Owned[ItemName] =
            (myFakeInventory[ItemType].Owned[ItemName] or 0) + Amount
    end

    -- 🔄 перерисовать свой профиль, если он открыт
    pcall(function()
        local mg = PlayerGui:FindFirstChild("MainGUI")
        local gf = mg and mg:FindFirstChild("Game")
        local VP = gf and gf:FindFirstChild("ViewProfile")
        if VP and VP.Visible and ViewProfileModule and ViewProfileModule.GenerateProfile then
            ViewProfileModule.GenerateProfile(VP, LP.Name, ProfileData)
        end
    end)
end

