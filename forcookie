-- 💬 AUTOCHAT CONTROLLER
-- ВАЖНО: создание/инъекция скрипта сама по себе чат НЕ запускает.
-- Чат стартует только после нажатия AUTOCHAT: ON.
-- ============================================================
local function StopBotAutoChat(playerName)
    local t = FakeChatTasks[playerName]
    if t then
        pcall(task.cancel, t)
        FakeChatTasks[playerName] = nil
    end
end

local function StartBotAutoChat(playerName, bot)
    if not _G.AutoChatEnabled then return end
    if not bot or not bot.Parent then return end

    StopBotAutoChat(playerName)

    FakeChatTasks[playerName] = task.spawn(function()
        -- Небольшая задержка после включения, чтобы боты не писали все одновременно.
        task.wait(math.random(1, 3))

        while _G.AutoChatEnabled
            and FakePlayers[playerName] == bot
            and bot.Parent do

            BotSay(playerName, BotChatMessages[math.random(1, #BotChatMessages)])

            -- Разный интервал, чтобы сообщения не шли синхронно.
            task.wait(math.random(40, 80))
        end

        FakeChatTasks[playerName] = nil
    end)
end

local function SetAutoChatEnabled(state)
    _G.AutoChatEnabled = state and true or false

    if not _G.AutoChatEnabled then
        for name, _ in pairs(FakeChatTasks) do
            StopBotAutoChat(name)
        end
        return
    end

    -- Включили кнопку: запускаем чат у уже существующих ботов.
    for name, bot in pairs(FakePlayers) do
        if bot and bot.Parent then
            StartBotAutoChat(name, bot)
        end
    end
end

local function StartBotBehavior(playerName, bot)
    if FakePlayerTasks[playerName] then task.cancel(FakePlayerTasks[playerName]); FakePlayerTasks[playerName] = nil end
    StopBotAutoChat(playerName)
    FakePlayerTasks[playerName] = task.spawn(function()
        if not bot or not bot.Parent then FakePlayerTasks[playerName] = nil; return end
        local rootPart = bot:FindFirstChild("HumanoidRootPart")
        local hum = bot:FindFirstChildOfClass("Humanoid")
        if not rootPart or not hum then FakePlayerTasks[playerName] = nil; return end
        task.wait(0.6)
        local spawnPos = rootPart.Position
        local walkRadius = 35
        hum.WalkSpeed = 16; hum.JumpPower = 50; hum.PlatformStand = false; hum.AutoRotate = true
        local animator = hum:FindFirstChild("Animator")
        if not animator then animator = Instance.new("Animator"); animator.Parent = hum end
        local animTracks = {}
        for name, id in pairs(ALL_ANIMATIONS) do
            local anim = Instance.new("Animation"); anim.AnimationId = id
            local ok, track = pcall(function() return animator:LoadAnimation(anim) end)
            if ok and track then track.Priority = Enum.AnimationPriority.Movement; animTracks[name] = track end
        end
        local currentAnim = nil
        local function PlayAnim(name, speed)
            if not animTracks[name] then return end
            if currentAnim == name then
                if speed and animTracks[name] then pcall(function() animTracks[name]:AdjustSpeed(speed) end) end
                return
            end
            for n, tr in pairs(animTracks) do
                if n ~= name then pcall(function() tr:Stop(0.15) end) end
            end
            pcall(function() animTracks[name]:Play(0.15); if speed then animTracks[name]:AdjustSpeed(speed) end end)
            currentAnim = name
        end
        local function MoveToPosition(targetPos, sprint)
            if not hum or not hum.Parent then return end
            local dir = targetPos - rootPart.Position
            local flatDir = Vector3.new(dir.X, 0, dir.Z)
            if flatDir.Magnitude < 0.1 then hum:Move(Vector3.new(0,0,0), false); return end
            hum.WalkSpeed = sprint and 15 or 12
            hum:Move(flatDir.Unit, false)
        end
        local function StopMoving()
            if hum and hum.Parent then hum:Move(Vector3.new(0,0,0), false) end
        end
        local function doJump()
            if hum and hum.Parent and hum.Health > 0 and hum.FloorMaterial ~= Enum.Material.Air then hum.Jump = true end
        end
        local function SayMessage()
            BotSay(playerName, BotChatMessages[math.random(1, #BotChatMessages)])
        end
        local function DoEmote()
            local track = PlayEmote(bot, BotEmotes[math.random(1, #BotEmotes)])
            if track then task.wait(3); pcall(function() track:Stop() end) end
        end
        local function LookAround()
            local angle = math.random() * 2 * math.pi
            rootPart.CFrame = CFrame.new(rootPart.Position) * CFrame.Angles(0, angle, 0)
        end
        local function GetNewTarget()
            local angle = math.random() * 2 * math.pi
            local dist = math.random(15, walkRadius)
            return spawnPos + Vector3.new(math.cos(angle) * dist, 0, math.sin(angle) * dist) + Vector3.new(0, 3, 0)
        end
        local function GetFollowTarget()
            local lpChar = LP.Character
            if not lpChar then return nil end
            local lpRoot = lpChar:FindFirstChild("HumanoidRootPart")
            if not lpRoot then return nil end
            return lpRoot.Position
        end
        local targetPos = GetNewTarget()
        local lastEmoteTime = 0
        StartBotAutoChat(playerName, bot)
        local stuckCounter = 0
        local lastPos = rootPart.Position
        local lastSpamJump = 0
        PlayAnim("IDLE", 1)
        while bot and bot.Parent and hum and hum.Health > 0 do
            if not FakePlayers[playerName] then break end
            if BOT_STAND_MODE then
                StopMoving()
                PlayAnim("IDLE", 1)
                task.wait(0.2)
                continue
            end
            if _G.SpamJumpEnabled then
                StopMoving()
                if tick() - lastSpamJump > 0.25 then
                    if hum.FloorMaterial ~= Enum.Material.Air then
                        PlayAnim("JUMP", 1); hum.Jump = true; task.wait(0.05); hum.Jump = false
                        task.delay(0.5, function()
                            if currentAnim == "JUMP" and not _G.FollowEnabled then PlayAnim("IDLE", 1) end
                        end)
                    end
                    lastSpamJump = tick()
                end
                task.wait(0.05); continue
            end
            local currentPos = rootPart.Position
            if _G.FollowEnabled then
                local lpPos = GetFollowTarget()
                if lpPos then
                    local distToPlayer = (lpPos - currentPos).Magnitude
                    if distToPlayer > 10 then
                        PlayAnim("RUN", 0.9)
                        MoveToPosition(lpPos, true)
                    elseif distToPlayer > 6 then
                        PlayAnim("WALK", 0.8)
                        MoveToPosition(lpPos, false)
                    else
                        PlayAnim("IDLE", 1)
                        StopMoving()
                    end
                    if distToPlayer < 3 then
                        StopMoving()
                    end
                end
                lastPos = currentPos
                task.wait(0.1)
                continue
            end
            local distToTarget = (targetPos - currentPos).Magnitude
            if distToTarget > 3 then
                if (currentPos - lastPos).Magnitude < 0.15 then stuckCounter = stuckCounter + 0.5
                else stuckCounter = math.max(0, stuckCounter - 0.3) end
            else stuckCounter = 0 end
            lastPos = currentPos
            if stuckCounter > 5 then
                PlayAnim("IDLE", 1); StopMoving(); targetPos = GetNewTarget(); stuckCounter = 0; task.wait(0.5)
            end
            if distToTarget < 3 then
                PlayAnim("IDLE", 1); StopMoving()
                if math.random() < 0.3 then LookAround() end
                task.wait(math.random(1, 3)); targetPos = GetNewTarget()
            else
                if distToTarget > 20 then PlayAnim("RUN", 1.2); MoveToPosition(targetPos, true)
                else PlayAnim("WALK", 1); MoveToPosition(targetPos, false) end
            end
            if math.random() < 0.03 then doJump(); task.wait(0.3) end
            if math.random() < 0.02 then LookAround(); task.wait(0.4) end
            if tick() - lastEmoteTime > math.random(70, 140) then DoEmote(); lastEmoteTime = tick() end
            task.wait(0.05)
        end
        StopBotAutoChat(playerName)
        if FakePlayers[playerName] == bot then FakePlayers[playerName] = nil end
        FakePlayerTasks[playerName] = nil
    end)
end

