local function isBlacklistedForBotProfile(key, name)
    if BOT_PROFILE_BLACKLIST[key] or BOT_PROFILE_BLACKLIST[name] then return true end
    if TROPHY_BLACKLIST[key] or TROPHY_BLACKLIST[name] then return true end
    local ln = string.lower(tostring(name or ""))
    local lk = string.lower(tostring(key or ""))
    if string.find(ln, "clown") or string.find(ln, "trophy")
        or string.find(ln, "sniper") or string.find(ln, "reaver")
        or string.find(ln, "gingerscythe") or string.find(ln, "synthwave")
        or (string.find(ln, "nik") and string.find(ln, "scythe"))
        or (string.find(lk, "nik") and string.find(lk, "scythe")) then
        return true
    end
    if (string.find(ln, "vampire") and string.find(ln, "axe") and string.find(ln, "trophy")) then
        return true
    end
    if (string.find(lk, "vampire") and string.find(lk, "axe") and string.find(lk, "trophy")) then
        return true
    end

    -- 🆕 Трофейные Vampire Axe (VampireAxe_Gold/Purple/Silver/Bronze) — блокируем
    -- ⚠️ Обычный VampireAxe (Rarity=Ancient) НЕ блокируем — он должен спавниться в профилях
    if string.find(lk, "vampireaxe_") or string.find(lk, "vampire_axe_")
        or string.find(lk, "vampireaxetrophy") or string.find(lk, "vampire_axe_trophy") then
        return true
    end

    -- Дротики, акулы
    if string.find(ln, "dartbringer") or string.find(lk, "dartbringer") then return true end
    if string.find(ln, "sharkseeker") or string.find(lk, "sharkseeker") then return true end

    if key == "Corrupt" or name == "Corrupt" or key == "Sorry" or name == "Sorry" then return false end

    -- Блокируем всё, что имеет редкость Unique в Sync (трофейные VampireAxe_Gold и т.д.)
    if Sync and Sync.Weapons then
        local dataKey = Sync.Weapons[key] or Sync.Weapons[name]
        if dataKey and dataKey.Rarity == "Unique" then return true end
    end

    return false
end

