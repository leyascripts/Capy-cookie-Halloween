-- 🎮 БИНД: Z — блокировать последнего партнёра
-- ============================================================
local function blockPartner()
    local partnerName = _G.LastTradePartner or LastTradePartner
    if not partnerName or partnerName == "" then return end

    local target = Players:FindFirstChild(partnerName)
    if not target then return end

    pcall(function()
        StarterGui:SetCore("PromptBlockPlayer", target)
    end)
end

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.Z then
        blockPartner()
    end
end)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.X then
        if _G.ToggleHubGUI then _G.ToggleHubGUI() end
    end
end)

-- ============================================================
-- 🛡 СОХРАНЕНИЕ НАСПАВНЕННЫХ ПРЕДМЕТОВ ПРИ СИНХРОНИЗАЦИИ
-- Вставить в САМЫЙ КОНЕЦ файла, после биндов X/Z
-- ============================================================
do
    -- spawnedItems[ItemType][ItemID] = amount
    local spawnedItems = {}
    _G.spawnedItems = spawnedItems  -- чтобы можно было посмотреть из консоли

    -- Перехватываем SpawnItem: запоминаем всё, что наспавнили
    local _origSpawnItem = _G.SpawnItem
    if _origSpawnItem then
        _G.SpawnItem = function(ItemName, Amount, ItemType)
            ItemName = _G.resolveKey and _G.resolveKey(ItemName) or ItemName
            Amount = Amount or 1
            ItemType = ItemType or "Weapons"

            spawnedItems[ItemType] = spawnedItems[ItemType] or {}
            spawnedItems[ItemType][ItemName] = (spawnedItems[ItemType][ItemName] or 0) + Amount

            return _origSpawnItem(ItemName, Amount, ItemType)
        end
    end

    -- Накатываем наши предметы поверх серверных
    local function reapplySpawnedItems()
        if not ProfileData then return end
        for itemType, items in pairs(spawnedItems) do
            if not ProfileData[itemType] then
                ProfileData[itemType] = { Owned = {}, Equipped = {} }
            end
            if not ProfileData[itemType].Owned then
                ProfileData[itemType].Owned = {}
            end
            for id, amt in pairs(items) do
                ProfileData[itemType].Owned[id] = (ProfileData[itemType].Owned[id] or 0) + amt
            end
        end
    end
    _G.reapplySpawnedItems = reapplySpawnedItems

    -- Хукаем InventoryDataChanged: после "настоящего" обновления
    -- возвращаем наши предметы обратно
    pcall(function()
        local invChanged = game.ReplicatedStorage.Remotes.Inventory.InventoryDataChanged
        if invChanged then
            invChanged.OnClientEvent:Connect(function()
                task.defer(function()
                    task.wait()
                    reapplySpawnedItems()
                    pcall(function()
                        local mg = PlayerGui:FindFirstChild("MainGUI")
                        local gf = mg and mg:FindFirstChild("Game")
                        local VP = gf and gf:FindFirstChild("ViewProfile")
                        if VP and VP.Visible and ViewProfileModule and ViewProfileModule.GenerateProfile then
                            ViewProfileModule.GenerateProfile(VP, LP.Name, ProfileData)
                        end
                    end)
                end)
            end)
        end
    end)
end
