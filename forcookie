BlockedWeaponKeys["NikKnife"] = "blocked"
local WeaponCatalog, WeaponByKey, WeaponByName = {}, {}, {}
_G.WeaponCatalog = WeaponCatalog

local function _blockKey(s) return (string.gsub(string.lower(tostring(s or "")), "[^%a%d]", "")) end

pcall(function()
    if Sync and Sync.Weapons then
        for key, data in pairs(Sync.Weapons) do
            if type(data) == "table" and (data.ItemType == "Knife" or data.ItemType == "Gun") then
                local rarity = data.Rarity or "Common"
                local isChroma = data.Chroma == true
                local name = data.ItemName or key
                if isJunkName(name) then
                    BlockedWeaponKeys[key] = "junk"
                else
                    local flat = _blockKey(name)
                    local blocked = false
                    for _, fam in ipairs(UntradableFamilies) do
                        if string.find(flat, fam, 1, true) then blocked = true; break end
                    end
                    if blocked then BlockedWeaponKeys[key] = "blocked"
                    else
                        local entry = { key=key, name=name, rarity=isChroma and "Chroma" or rarity, type=data.ItemType, chroma=isChroma }
                        table.insert(WeaponCatalog, entry)
                        WeaponByKey[key] = entry
                        WeaponByName[string.lower(entry.name)] = entry
                    end
                end
            end
        end
        local order = { Chroma=1, Godly=2, Ancient=3, Unique=4, Legendary=5, Classic=6, Vintage=7, Rare=8, Uncommon=9, Common=10 }
        table.sort(WeaponCatalog, function(a, b)
            local ra, rb = order[a.rarity] or 99, order[b.rarity] or 99
            if ra ~= rb then return ra < rb end
            return a.name < b.name
        end)
    end
end)

