function updateFakePartnerInventory(partnerName, gaveItems, receivedItems)
    if not partnerName or partnerName == "" then return end

    -- 🛡 создаём фрейм партнёра, чтобы хук его увидел
    fakePlayerFrames = fakePlayerFrames or {}
    if not fakePlayerFrames[partnerName] then
        local f = Instance.new("Frame")
        f.Name = tostring(partnerName)
        f.Visible = false
        f.Parent = PlayerGui
        fakePlayerFrames[partnerName] = f
    end
        -- 🎯 берём настоящий уровень/престиж партнёра
    pcall(function()
        local f = fakePlayerFrames[partnerName]
        if not f then return end

        -- пробуем GetPlayerProfile
        local ok, prof = pcall(function()
            return game.ReplicatedStorage.Remotes.Misc.GetPlayerProfile:InvokeServer(partnerName)
        end)

        local lvl, prest = nil, nil
        if ok and type(prof) == "table" then
            lvl = prof.Level or prof.level
            prest = prof.Prestige or prof.prestige
        end

        -- если нет — пробуем GetProfileData
        if not lvl then
            local ok2, prof2 = pcall(function()
                return game.ReplicatedStorage.Remotes.Inventory.GetProfileData:InvokeServer(partnerName)
            end)
            if ok2 and type(prof2) == "table" then
                lvl = prof2.Level or prof2.level
                prest = prof2.Prestige or prof2.prestige
            end
        end

        f:SetAttribute("FakeLevel", lvl or 1)
        f:SetAttribute("FakePrestige", prest or 0)
    end)

    -- 🔁 локальный алиас
    local function rk(id)
        if not id then return id end
        if _G.resolveKey then return _G.resolveKey(id) end
        if id == "Corrupt" then return "Sorry" end
        return id
    end

        -- 1) берём НАСТОЯЩИЙ инвентарь партнёра с сервера
    fakeProfileCache = fakeProfileCache or {}
    local cached = fakeProfileCache[partnerName]

    local ok, realInv = pcall(function()
        return game.ReplicatedStorage.Remotes.Extras.GetFullInventory:InvokeServer(partnerName)
    end)

    if ok and type(realInv) == "table" and next(realInv) ~= nil then
        -- 🆕 просто перезаписываем настоящим инвентарём.
        -- Фейковые предметы (отданные/полученные в ЭТОМ трейде) накатятся ниже
        -- через gaveItems / receivedItems — без задвоения.
        if not cached then cached = {} end
        cached.inventory = realInv
    elseif not cached then
        local ok2, c = pcall(function() return getFakeProfileData(partnerName) end)
        if ok2 and c then cached = c end
    end

    if not cached then
        cached = { profile = nil, inventory = nil, avatarImage = nil }
    end
    fakeProfileCache[partnerName] = cached

    -- 2) гарантируем inventory
    if not cached.inventory then cached.inventory = {} end
    local inv = cached.inventory
    for _, cat in ipairs({"Weapons","Effects","Perks","Emotes","Radios","Pets"}) do
        if not inv[cat] then inv[cat] = { Owned = {}, Equipped = {} } end
        if not inv[cat].Owned then inv[cat].Owned = {} end
        if not inv[cat].Equipped then inv[cat].Equipped = {} end
    end

    -- ➕ ДОБАВЛЯЕМ то, что Я ему отдал
    for _, givenItem in ipairs(gaveItems or {}) do
        local cat = givenItem[3] or givenItem.ItemType or "Weapons"
        local amt = tonumber(givenItem[2] or givenItem.Amount) or 1
        local id  = rk(givenItem[1] or givenItem.ItemID)
        if id and inv[cat] then
            if cat == "Weapons" or cat == "Pets" then
                inv[cat].Owned[id] = (inv[cat].Owned[id] or 0) + amt
            else
                for _ = 1, amt do table.insert(inv[cat].Owned, id) end
            end
        end
    end

    -- ➖ ВЫЧИТАЕМ то, что ОН мне отдал
    for _, receivedItem in ipairs(receivedItems or {}) do
        local cat = receivedItem[3] or receivedItem.ItemType or "Weapons"
        local amt = tonumber(receivedItem[2] or receivedItem.Amount) or 1
        local id  = rk(receivedItem[1] or receivedItem.ItemID)
        if id and inv[cat] and inv[cat].Owned then
            if cat == "Weapons" or cat == "Pets" then
                local cur = inv[cat].Owned[id] or 0
                local newVal = cur - amt
                if newVal <= 0 then inv[cat].Owned[id] = nil else inv[cat].Owned[id] = newVal end
            else
                local removed = 0
                for i = #inv[cat].Owned, 1, -1 do
                    if removed >= amt then break end
                    if inv[cat].Owned[i] == id then
                        table.remove(inv[cat].Owned, i)
                        removed = removed + 1
                    end
                end
            end
        end
    end

    -- 3) сброс кэша рендера
    pcall(function()
        if ViewProfileModule and ViewProfileModule.PlayerInventories then
            ViewProfileModule.PlayerInventories[partnerName] = nil
        end
    end)

    -- 4) перерисовать профиль партнёра (даже если закрыт — данные уже в cached)
    pcall(function()
        if ViewProfileModule and ViewProfileModule.GenerateProfile then
            local mg = PlayerGui:FindFirstChild("MainGUI")
            local gf = mg and mg:FindFirstChild("Game")
            local VP = gf and gf:FindFirstChild("ViewProfile")
            if VP then
                ViewProfileModule.GenerateProfile(VP, partnerName, cached.inventory)
            end
        end
    end)
end

