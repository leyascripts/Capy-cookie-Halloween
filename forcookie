                    Pets = { Owned = {}, Equipped = {} }, Uniques = {}
                }
            end
            local inv = cache.inventory
            if not inv.Weapons then inv.Weapons = { Owned = {}, Equipped = { Knife = "DefaultKnife", Gun = "DefaultGun" } } end
            if not inv.Weapons.Owned then inv.Weapons.Owned = {} end
            if not inv.Weapons.Owned.DefaultKnife then inv.Weapons.Owned.DefaultKnife = 1 end
            if not inv.Weapons.Owned.DefaultGun then inv.Weapons.Owned.DefaultGun = 1 end

            for _ = 1, count do
                local entry = cleanPool[math.random(1, #cleanPool)]
                if entry and entry.key then
                    local amt = math.random(1, 3)
                    inv.Weapons.Owned[entry.key] = (inv.Weapons.Owned[entry.key] or 0) + amt
                    added = added + 1
                end
            end

            pcall(function()
                if ViewProfileModule and ViewProfileModule.PlayerInventories then
                    ViewProfileModule.PlayerInventories[name] = nil
                end
            end)
        end
    end
    return added
end

