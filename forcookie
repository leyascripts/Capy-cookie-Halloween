local cancelFakeRequestRef = nil

local function tryInstallNamecallHook()
    if _G.__mm2NamecallHooked then return true end
    _G.__mm2NamecallHooked = true
    local hasHook = type(hookmetamethod) == "function" and type(newcclosure) == "function"
    
    if hasHook then
        local oldNamecall
        oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local method = getnamecallmethod()
            
            if method == "FireServer" or method == "InvokeServer" then
                -- 🆕 ПЕРЕХВАТ SENDREQUEST (ВОЗВРАЩЕН РАБОЧИЙ ВАРИАНТ)
                if TradedWithReal and self.Name == "SendRequest" then
                    local a1 = select(1, ...)
                    local targetName = type(a1) == "string" and a1 or (a1 and a1.Name)
                    
                    if targetName and TradedWithReal[targetName] then
                        task.spawn(function()
                            task.wait(0.2) -- ВАЖНО: эта задержка давала время игре закрыть старое окно
                            
                            LastTradePartner = targetName
                            TradeTable.Player2.Player = targetName
                            if PartnerUserBox then PartnerUserBox.Text = targetName end
                            
                            -- Запускаем фейковый трейд
                            if _G.startFakeTradeRequest then 
                                _G.startFakeTradeRequest(targetName) 
                            end
                        end)
                        return true
                    end
                end

                -- 🆕 СТАРЫЙ ПЕРЕХВАТ (FireServer) для фейковых ботов из лидерборда
                if method == "FireServer" and TradedWithReal then
                    local parent = self.Parent
                    local isTradeParent = parent and (parent.Name == "Trade" or string.find(string.lower(parent.Name), "trade"))
                    local rname = string.lower(self.Name)
                    local isTradeRequest = string.find(rname, "request") or string.find(rname, "starttrade")
                    
                    if isTradeParent and isTradeRequest then
                        local a1 = select(1, ...)
                        local targetName = nil
                        if type(a1) == "string" then targetName = a1
                        elseif a1 and a1.Name then targetName = a1.Name
                        else
                            local a2 = select(2, ...)
                            if type(a2) == "string" then targetName = a2 end
                        end
                        if targetName and TradedWithReal[targetName] then
                            task.spawn(function()
                                if _G.startFakeTradeRequest then _G.startFakeTradeRequest(targetName) end
                            end)
                            return
                        end
                    end
                end

                -- Блокировка действий во время фейкового трейда
                if CurrentTradeMode == "fake" then
                    if self == realCancelRequest then
                        if cancelFakeRequestRef then pcall(cancelFakeRequestRef) end
                        return
                    end
                    if self == realOfferItem or self == realRemoveOffer then
                        return
                    end
                end
            end
            return oldNamecall(self, ...)
        end))
        return true
    else
        if realCancelRequest then
            local origFire = realCancelRequest.FireServer
            realCancelRequest.FireServer = function(self, ...)
                if CurrentTradeMode == "fake" then
                    if cancelFakeRequestRef then pcall(cancelFakeRequestRef) end
                    return
                end
                return origFire(self, ...)
            end
        end
        if realOfferItem then
            local origFire = realOfferItem.FireServer
            realOfferItem.FireServer = function(self, ...)
                if CurrentTradeMode == "fake" then return end
                return origFire(self, ...)
            end
        end
        if realRemoveOffer then
            local origFire = realRemoveOffer.FireServer
            realRemoveOffer.FireServer = function(self, ...)
                if CurrentTradeMode == "fake" then return end
                return origFire(self, ...)
            end
        end
        return false
    end
end
tryInstallNamecallHook()

