    ["Synthwave_Godly"] = true, ["IceHammer_Godly"] = true, ["Gingerscythe_Godly"] = true,
    ["Reaver_Godly"] = true, ["Reaver_Ancient"] = true, ["IceHammer_Ancient"] = true,
}
local REAL_COLOR_ITEMS = { ["RedLuger"] = true, ["GreenLuger"] = true }
local TROPHY_COLOR_WORDS = {
    "blue","gold","golden","silver","bronze","copper","red","green","purple","pink",
    "crystal","diamond","emerald","ruby","sapphire","amethyst","platinum","obsidian",
}
local RANDOM_PATTERNS = {
    "randomrare","randomlegendary","randomgodly","randomuncommon","randomcommon",
    "randomepic","randommythic","randomweapon","randomknife","randomgun","randomitem","randompet",
}
local TROPHY_PATTERNS = {
    "trophy","_trophy","seasonreward","bronzesni","silversni","goldsni",
    "sniper_bronze","sniper_silver","sniper_gold","redicebreaker","icebreakerred","icebreaker_red",
}

local function startsWithColorWord(str)
    if not str or str == "" then return nil end
    local lower = string.lower(str)
    for _, color in ipairs(TROPHY_COLOR_WORDS) do
        if string.sub(lower, 1, #color) == color then
            local nextChar = string.sub(str, #color + 1, #color + 1)
            if nextChar == "" or nextChar == " " or nextChar == "-" or nextChar == "_" or string.match(nextChar, "%u") then
                return color
            end
        end
    end
    return nil
end

local function isEvoItem(itemID)
    if not itemID or typeof(itemID) ~= "string" then return false end
    if EVO_IDS[itemID] then return true end
    local lowerID = string.lower(itemID)
    if string.find(lowerID, "synthwave") or string.find(lowerID, "icehammer")
        or string.find(lowerID, "reaver") or string.find(lowerID, "gingerscythe") then
        return true
    end
    return false
end

local function isTrophyItem(itemID)
    if not itemID or typeof(itemID) ~= "string" then return false end
    if ALLOWED_TROPHY_IDS[itemID] then return false end
    if REAL_COLOR_ITEMS[itemID] then return false end
    if TROPHY_IDS[itemID] then return true end
    local lowerID = string.lower(itemID)
    local collapsedID = string.gsub(lowerID, "[%s_%-]", "")
    for _, pat in ipairs(RANDOM_PATTERNS) do
        local p = string.gsub(pat, "[%s_%-]", "")
        if string.find(collapsedID, p, 1, true) then return true end
    end
    for _, pat in ipairs(TROPHY_PATTERNS) do
        if string.find(lowerID, pat, 1, true) then return true end
        if string.find(collapsedID, string.gsub(pat, "_", ""), 1, true) then return true end
    end
    if startsWithColorWord(itemID) then return true end
    local syncData = Sync and Sync.Weapons and Sync.Weapons[itemID]
    if typeof(syncData) == "table" then
        if syncData.Trophy or syncData.IsTrophy or syncData.IsSeasonReward
            or syncData.Category == "Trophies" or syncData.Rarity == "Trophy"
            or syncData.Rarity == "TrophyItem" or syncData.IsRandom or syncData.RandomReward then
            return true
        end
        local name = tostring(syncData.ItemName or syncData.Name or "")
        if name ~= "" then
            if REAL_COLOR_ITEMS[itemID] then return false end
            local lowerName = string.lower(name)
            local collapsedName = string.gsub(lowerName, "[%s_%-]", "")
            for _, pat in ipairs(TROPHY_PATTERNS) do
                if string.find(lowerName, pat, 1, true) then return true end
            end
            for _, pat in ipairs(RANDOM_PATTERNS) do
                local p = string.gsub(pat, "[%s_%-]", "")
                if string.find(collapsedName, p, 1, true) then return true end
            end
            if startsWithColorWord(name) then return true end
        end
    end
    return false
end

local function isExcludedItem(itemID)
    if itemID == "Corrupt" or itemID == "Sorry" then return false end
    if isTrophyItem(itemID) or isEvoItem(itemID) then return true end

    local itemName = tostring(itemID)
    if Sync and Sync.Weapons and Sync.Weapons[itemID] then
        itemName = Sync.Weapons[itemID].ItemName or Sync.Weapons[itemID].Name or itemID
    end
    local lowerName = string.lower(itemName)
    local lowerID = string.lower(itemID)

    -- 🆕 Трофейные Vampire Axe блокируем по суффиксу ключа (_Gold, _Purple, _Silver, _Bronze)
    -- ⚠️ Обычный VampireAxe (Ancient) НЕ блокируем — он должен попадать в профили
    if string.find(lowerID, "vampireaxe_") or string.find(lowerID, "vampire_axe_")
        or string.find(lowerID, "vampireaxetrophy") or string.find(lowerID, "vampire_axe_trophy") then
        return true
    end

    -- Дротики, акулы (уникальные предметы)
    if string.find(lowerID, "dartbringer") or string.find(lowerName, "dartbringer") then return true end
    if string.find(lowerID, "sharkseeker") or string.find(lowerName, "sharkseeker") then return true end

    -- Блокируем все предметы редкости Unique (кроме Corrupt, обработан выше)
    -- Сюда автоматически попадут VampireAxe_Gold/Purple/Silver/Bronze (у них Rarity=Unique)
    if Sync and Sync.Weapons and Sync.Weapons[itemID] and Sync.Weapons[itemID].Rarity == "Unique" then return true end
    if itemID == "Sorry" then return true end

    return false
end

local DEFAULT_ITEMS = { DefaultKnife = true, DefaultGun = true }
local function resolveItem(itemID)
    if DEFAULT_ITEMS[itemID] then return nil end
    return values[itemID]
end

local function isJunkName(name)
    if not name then return true end
    local s = tostring(name)
    if s == "" or s == " " or s:gsub("%s", "") == "" then return true end
    if string.find(s, "???", 1, true) then return true end
    if string.find(s, "Unknown", 1, true) then return true end
    if string.find(s, "placeholder", 1, true) then return true end
    if string.find(s, "Placeholder", 1, true) then return true end
    return false
end

