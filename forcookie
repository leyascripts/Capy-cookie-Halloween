    local cache = fakeProfileCache[name]
    local data = fakePlayerData[name] or {}
    if not cache.profile then cache.profile = generateFakeProfile(name, data.level or 1, data.prestige or 0, data.isElite) end
    if not cache.inventory then cache.inventory = generateFakeInventory() end
    if not cache.avatarImage then pcall(function() fetchAvatarSync(name, cache) end) end
    return cache
end

local function getTemplateFrame()
    if cachedTemplate and cachedTemplate.Parent == nil then cachedTemplate = nil end
    if cachedTemplate then return cachedTemplate end
    if not refreshLeaderboardRefs() then return nil end
    for _, child in pairs(LeaderboardContainer:GetChildren()) do
        if child:FindFirstChild("IsPlayerFrame") then
            local ok, clone = pcall(function() return child:Clone() end)
            if ok and clone then cachedTemplate = clone; return clone end
        end
    end
    return nil
end

local function sortLeaderboard()
    if not LeaderboardContainer then return end
    local frames = {}
    for _, child in pairs(LeaderboardContainer:GetChildren()) do
        if child:GetAttribute("IsFake") or child:FindFirstChild("IsPlayerFrame") then
            local prestige = child:GetAttribute("FakePrestige") or 0
            local level = child:GetAttribute("FakeLevel") or 1
            table.insert(frames, { Frame = child, Prestige = prestige, Level = level })
        end
    end
    table.sort(frames, function(a, b)
        if a.Prestige ~= b.Prestige then return a.Prestige > b.Prestige end
        return a.Level > b.Level
    end)
    for i, data in ipairs(frames) do
        data.Frame.LayoutOrder = i
        if data.Frame:GetAttribute("IsFake") then
            data.Frame.Visible = not HIDE_PLAYERS_MODE
        end
    end
end

local function addFakePlayer(name, level, prestige, isElite)
    if not name or name == "" then return false end
    if fakePlayerFrames[name] and fakePlayerFrames[name].Parent then return false end
    for _ = 1, 20 do if refreshLeaderboardRefs() then break end; task.wait(0.2) end
    if not LeaderboardContainer then return false end
    local template
    for _ = 1, 10 do
        template = getTemplateFrame()
        if template then break end
        task.wait(0.3)
    end
    if not template then return false end
    local frame
    local ok = pcall(function()
        frame = template:Clone()
        frame.Name = "FAKE_" .. name
        if frame:FindFirstChild("IsPlayerFrame") then frame.IsPlayerFrame:Destroy() end
        local prefix = isElite and "[ELITE] " or ""
        if frame:FindFirstChild("PlayerLabel") then
            frame.PlayerLabel.Text = prefix .. name
            frame.PlayerLabel.TextColor3 = isElite and Color3.fromRGB(232,42,42) or Color3.new(1,1,1)
        end
        local lvl = tonumber(level) or 1
        local prest = tonumber(prestige) or 0
        local lvlFrame = frame:FindFirstChild("Level")
        if lvlFrame then
            local levelImg = lvlFrame:IsA("ImageLabel") and lvlFrame or lvlFrame:FindFirstChild("Level") or lvlFrame:FindFirstChild("Icon")
            if levelImg and levelImg:IsA("ImageLabel") then
                levelImg.Image = "https://www.roblox.com/asset/?id=" .. getLevelIcon(lvl)
                levelImg.Visible = true
                local pl = levelImg:FindFirstChild("Prestige")
                if pl and pl:IsA("TextLabel") then pl.Text = getRoman(prest) .. " " end
                local lt = levelImg:FindFirstChild("Level")
                if lt and lt:IsA("TextLabel") then lt.Text = tostring(lvl) end
            end
        end
        if frame:FindFirstChild("XPBar") then frame.XPBar.Visible = false end
        frame:SetAttribute("FakePrestige", prest)
        frame:SetAttribute("FakeLevel", lvl)
        frame:SetAttribute("IsFake", true)
        frame.Visible = not HIDE_PLAYERS_MODE
        frame.Parent = LeaderboardContainer
    end)
    if not ok or not frame or not frame.Parent then return false end
    fakePlayerFrames[name] = frame
    fakePlayerData[name] = { level=level, prestige=prestige, isElite=isElite }
    task.spawn(function() pcall(function() getFakeProfileData(name) end) end)
    sortLeaderboard()
    local actionBtn = frame:FindFirstChild("ActionButton")
    if not actionBtn then
        for _, d in ipairs(frame:GetDescendants()) do
            if (d:IsA("TextButton") or d:IsA("ImageButton")) and d.Name ~= "IsPlayerFrame" then actionBtn = d; break end
        end
    end
    if actionBtn then
        local function onClick()
            if not refreshLeaderboardRefs() then return end
            local inspect = Leaderboard:FindFirstChild("Inspect")
            if not inspect then return end
            local cont = inspect:FindFirstChild("Container")
            if not cont then return end
            if cont:FindFirstChild("Username") then cont.Username.Text = name end
            pcall(function() inspect.Position = UDim2.new(inspect.Position.X, UDim.new(0, frame.AbsolutePosition.Y + 45)) end)
            if cont:FindFirstChild("Trade") then cont.Trade.Visible = true end
            if cont:FindFirstChild("Profile") then cont.Profile.Visible = true end
            if cont:FindFirstChild("Prestige") then cont.Prestige.Visible = false end
            inspect.Visible = true
        end
        actionBtn.Activated:Connect(onClick)
        if actionBtn:IsA("TextButton") or actionBtn:IsA("ImageButton") then
            actionBtn.MouseButton1Click:Connect(onClick)
        end
    end
    return true
end

