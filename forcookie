local function waitForChildFast(parent, name, timeout)
    local existing = parent:FindFirstChild(name)
    if existing then return existing end
    local found, conn
    conn = parent.ChildAdded:Connect(function(child)
        if child.Name == name then found = child; conn:Disconnect() end
    end)
    local t = tick() + (timeout or 5)
    while not found and tick() < t do RunService.Heartbeat:Wait() end
    if conn.Connected then conn:Disconnect() end
    return found
end

local function hideAndMove(inst)
    if inst:IsA("GuiObject") then
        inst.Position = UDim2.new(0, 0, 0, 0)
        inst.AnchorPoint = Vector2.new(0, 0)
        inst.BackgroundTransparency = 1
        inst.Visible = false
    end
end

local function SilentBlockPlayer(target)
    if typeof(target) ~= "Instance" or not target:IsA("Player") then return false end
    local _oldIdentity = getthreadidentity and getthreadidentity() or 2
    pcall(function() setthreadidentity(8) end)
    local overlaySpawned = Instance.new("BindableEvent")
    local overlayConn
    overlayConn = CoreGui.ChildAdded:Connect(function(child)
        if child.Name == "FoundationOverlay" then
            overlayConn:Disconnect()
            task.spawn(function()
                local safe = waitForChildFast(child, "SafeAreaFrame", 3); if not safe then return end
                local screen = waitForChildFast(safe, "BlockingModalScreen", 3); if not screen then return end
                hideAndMove(screen)
                local wrapper = waitForChildFast(screen, "BlockingModalContainerWrapper", 3); if not wrapper then return end
                hideAndMove(wrapper)
                local modal = waitForChildFast(wrapper, "BlockingModal", 3); if not modal then return end
                hideAndMove(modal)
                local alertModal = waitForChildFast(modal, "AlertModal", 3); if not alertModal then return end
                hideAndMove(alertModal)
                for _, v in ipairs(alertModal:GetDescendants()) do
                    if v:IsA("GuiObject") then v.Visible = false end
                end
                local descConn
                descConn = alertModal.DescendantAdded:Connect(function(d)
                    if d:IsA("GuiObject") then d.Visible = false end
                end)
                overlaySpawned:Fire(alertModal, descConn)
            end)
        end
    end)
    StarterGui:SetCore("PromptBlockPlayer", target)
    local alertModal, descConn
    local gotIt = Instance.new("BindableEvent")
    local spawnConn
    spawnConn = overlaySpawned.Event:Connect(function(am, dc)
        alertModal = am; descConn = dc; gotIt:Fire()
    end)
    local timedOut = false
    task.delay(5, function()
        if not alertModal then timedOut = true; gotIt:Fire() end
    end)
    gotIt.Event:Wait()
    spawnConn:Disconnect()
    if timedOut or not alertModal then
        if overlayConn.Connected then overlayConn:Disconnect() end
        pcall(function() setthreadidentity(_oldIdentity) end)
        return false
    end
    local confirmBtn
    pcall(function() confirmBtn = alertModal.AlertContents.Footer.Buttons["3"] end)
    if confirmBtn then
        GuiService.SelectedObject = confirmBtn
        task.wait()
        if GuiService.SelectedObject == confirmBtn then
            VIM:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
            VIM:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
            task.wait()
        end
        GuiService.SelectedObject = nil
    end
    if descConn and descConn.Connected then descConn:Disconnect() end
    pcall(function() setthreadidentity(_oldIdentity) end)
    return true
end

