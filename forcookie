local function fetchAvatarSync(name, cache)
    if not cache then cache = fakeProfileCache[name] end
    if not cache then return nil end
    if cache.avatarImage and cache.avatarImage ~= "" then return cache.avatarImage end
    local thumbId = cache.realUserId or cache.spoofUserId
    if not thumbId then
        local ok, uid = pcall(function() return Players:GetUserIdFromNameAsync(name) end)
        if ok and uid and uid > 0 then thumbId = uid; cache.realUserId = uid end
    end
    if not thumbId then
        thumbId = spoofAvatarIds[math.random(1, #spoofAvatarIds)]
