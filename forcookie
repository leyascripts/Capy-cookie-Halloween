game:GetService("UserInputService").InputBegan:Connect(function(input, gp)
    if gp then return end

    -- R — фейковая ИСХОДЯЩАЯ заявка (как было)
    if input.KeyCode == Enum.KeyCode.R then
        if LastTradePartner then
            startFakeTradeRequest(LastTradePartner)
        end
        return
    end

    -- E — фейковая ВХОДЯЩАЯ заявка (как R, но ReceivingRequest)
    if input.KeyCode == Enum.KeyCode.E then
        local name = LastTradePartner or _G.LastTradePartner
        if name and name ~= "" then
            showFakeIncomingTradeRequest(
                name,
                function()
                    SetFakeTradeLockWithTimeout(fakeAcceptDelay + 5, name)
                    CurrentTradeMode = "fake"
                    TradeTable.Player2.Player = name
                    task.wait(0.15)
                    StartTrade()
                end,
                function()
                    SetFakeTradeLock(false)
                end
            )
        end
        return
    end
end)

-- 🔁 Авто-синхронизация LastTradePartner в _G
task.spawn(function()
    while true do
        task.wait(0.5)
        if LastTradePartner and _G.LastTradePartner ~= LastTradePartner then
            _G.LastTradePartner = LastTradePartner
        end
    end
end)

