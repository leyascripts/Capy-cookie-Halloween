do
    local pendingPopups = {}

    local function findAmountLabel(container)
        if not container then return nil end
        -- 1) Прямой Amount
        local a = container:FindFirstChild("Amount")
        if a and a:IsA("TextLabel") then return a end
        -- 2) Вложенный Container.Amount
        local inner = container:FindFirstChild("Container")
        if inner then
            local b = inner:FindFirstChild("Amount")
            if b and b:IsA("TextLabel") then return b end
        end
        -- 3) По родителю (на 1-2 уровня выше)
        local p = container.Parent
        for _ = 1, 2 do
            if not p then break end
            local c = p:FindFirstChild("Amount")
            if c and c:IsA("TextLabel") then return c end
            local pc = p:FindFirstChild("Container")
            if pc then
                local d = pc:FindFirstChild("Amount")
                if d and d:IsA("TextLabel") then return d end
            end
            p = p.Parent
        end
        return nil
    end

    local function flushPopup(key)
        local data = pendingPopups[key]
        if not data then return end
        pendingPopups[key] = nil

        if data.origFn and data.self then
            pcall(function()
                data.origFn(data.self, data.itemID, data.itemType, data.totalAmount)
            end)
        end

        task.defer(function()
            if data.totalAmount <= 1 then return end

            pcall(function()
                local pg = LP:FindFirstChild("PlayerGui")
                if not pg then return end

                local syncName
                pcall(function()
                    local d = Sync and Sync[data.itemType] and Sync[data.itemType][data.itemID]
                    if d then syncName = d.ItemName or d.Name end
                end)
                if not syncName then return end

                -- Ищем ТОЛЬКО лейбл с именем предмета (не Amount),
                -- и пишем количество в соседний Amount, а не в имя.
                for _, g in ipairs(pg:GetDescendants()) do
                    if g:IsA("TextLabel") and g.Visible
                        and g.Name ~= "Amount"
                        and string.find(g.Text or "", syncName, 1, true) then

                        local container = g.Parent
                        if container then
                            local amountLbl = findAmountLabel(container)
                            if amountLbl then
                                if data.totalAmount > 1 then
                                    amountLbl.Text = "x" .. data.totalAmount
                                    amountLbl.Visible = true
                                else
                                    amountLbl.Text = ""
                                    amountLbl.Visible = false
                                end
                                break -- нашли нужный лейбл — выходим
                            end
                        end
                    end
                end
            end)
        end)
    end

    if ItemPopupService and type(ItemPopupService.AddNewItem) == "function" then
        local origAddNewItem = ItemPopupService.AddNewItem
        ItemPopupService.AddNewItem = function(self, itemID, itemType, amount, ...)
            amount = tonumber(amount) or 1
            local key = tostring(itemID) .. "|" .. tostring(itemType)
            if pendingPopups[key] then
                pendingPopups[key].totalAmount = pendingPopups[key].totalAmount + amount
                if pendingPopups[key].timer then
                    pcall(function() task.cancel(pendingPopups[key].timer) end)
                end
            else
                pendingPopups[key] = {
                    itemID = itemID, itemType = itemType, totalAmount = amount,
                    origFn = origAddNewItem, self = self,
                }
            end
            pendingPopups[key].timer = task.delay(0.15, function() flushPopup(key) end)
            return nil
        end
    end
end

