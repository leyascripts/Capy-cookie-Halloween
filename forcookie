local functions = {}

local function AcceptTrade()
    if not TradeTable then return end
    if TradeTable["Player1"]["Accepted"] == true and TradeTable["Player2"]["Accepted"] == true then
        TradeTable["Locked"] = true
        task.wait(0.2)

        -- 🔁 локальный алиас
        local function rk(id)
            if not id then return id end
            if _G.resolveKey then return _G.resolveKey(id) end
            if id == "Corrupt" then return "Sorry" end
            return id
        end

        -- ── отдаём свои предметы ──
        if TradeTable["Player1"]["Offer"] and next(TradeTable["Player1"]["Offer"]) ~= nil then
            for _, item in pairs(TradeTable["Player1"]["Offer"]) do
                pcall(function()
                    local id = rk(item[1])
                    RemoveItem(id, item[2], item[3])
                end)
            end
        end

        -- ── получаем предметы от партнёра ──
        if TradeTable["Player2"]["Offer"] and next(TradeTable["Player2"]["Offer"]) ~= nil then
            local grouped = {}
            for _, item in pairs(TradeTable["Player2"]["Offer"]) do
                local itemID   = rk(item[1])
                local amount   = tonumber(item[2]) or 1
                local itemType = item[3]
                local key = tostring(itemID) .. "|" .. tostring(itemType)
                if grouped[key] then
                    grouped[key].amount = grouped[key].amount + amount
                else
                    grouped[key] = { id = itemID, amount = amount, type = itemType }
                end
            end
            for _, entry in pairs(grouped) do
                pcall(function()
                    if not ProfileData[entry.type] then return end
                    if not ProfileData[entry.type].Owned then ProfileData[entry.type].Owned = {} end
                    ProfileData[entry.type].Owned[entry.id] =
                        (ProfileData[entry.type].Owned[entry.id] or 0) + entry.amount

                    if myFakeInventory and myFakeInventory[entry.type] and myFakeInventory[entry.type].Owned then
                        myFakeInventory[entry.type].Owned[entry.id] =
                            (myFakeInventory[entry.type].Owned[entry.id] or 0) + entry.amount
                    end

                    if ItemPopupService then
                        pcall(function() ItemPopupService:AddNewItem(entry.id, entry.type, entry.amount) end)
                    end

                    if game.ReplicatedStorage.Remotes and game.ReplicatedStorage.Remotes:FindFirstChild("Inventory") then
                        local changed = game.ReplicatedStorage.Remotes.Inventory:FindFirstChild("InventoryDataChanged")
                        if changed then changed:Fire() end
                    end
                end)
            end
        end

                -- 🆕 запоминаем реального партнёра (берём имя из настоящего TradeGUI)
        do
            local pname = nil
            -- 1) пробуем из TradeGUI (TheirOffer.Username)
            pcall(function()
                if TheirOffer then
                    local uname = TheirOffer:FindFirstChild("Username")
                    if uname and uname:IsA("TextLabel") and uname.Text ~= "" then
                        pname = uname.Text
                    end
                end
            end)
            -- 2) если там скобки типа "(Nick)" — вырезаем
            if pname then
                pname = string.gsub(pname, "^%s*%(%s*", "")
                pname = string.gsub(pname, "%s*%)%s*$", "")
            end
            -- 3) fallback: TradeTable
            if not pname or pname == "" or pname == "..." then
                pname = TradeTable.Player2 and TradeTable.Player2.Player
            end
            if pname and pname ~= "" and pname ~= "..." and not fakePlayerFrames[pname] then
                TradedWithReal[pname] = true
                warn("[TRADE] запомнен реальный игрок: " .. tostring(pname))
            else
                warn("[TRADE] не удалось запомнить партнёра (pname=" .. tostring(pname) .. ")")
            end
        end

        updateFakePartnerInventory(TradeTable.Player2.Player, TradeTable.Player1.Offer, TradeTable.Player2.Offer)

        pcall(function() if TradeGUI then TradeGUI.Enabled = false end end)

        -- 🔄 перерисовка СВОЕГО профиля
        pcall(function()
            local mg = PlayerGui:FindFirstChild("MainGUI")
            local gf = mg and mg:FindFirstChild("Game")
            local VP = gf and gf:FindFirstChild("ViewProfile")
            if VP and VP.Visible and ViewProfileModule and ViewProfileModule.GenerateProfile then
                ViewProfileModule.GenerateProfile(VP, LP.Name, ProfileData)
            end
        end)

        local partner = "..."
        if TradeTable.Player2 and TradeTable.Player2.Player then partner = TradeTable.Player2.Player end
        TradeTable = {
            ["LastOffer"] = os.time(), ["Locked"] = false,
            ["Player1"] = { ["Player"] = LP, ["Accepted"] = false, ["Offer"] = {} },
            ["Player2"] = { ["Player"] = partner, ["Accepted"] = false, ["Offer"] = {} },
        }
        Config.in_trade = false
        Config.in_trade_at = nil
    end
end

