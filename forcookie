    local cleanPool = {}
    for _, entry in ipairs(WeaponCatalog) do
        if entry and entry.key and entry.name and not isJunkName(entry.name) then
            if not isBlacklistedForBotProfile(entry.key, entry.name)
                and not isTrophyItem(entry.key) and not isEvoItem(entry.key)
                and entry.rarity ~= "Chroma" then   -- 🚫 хромы ботам не даём
                table.insert(cleanPool, entry)
            end
        end
    end
    if #cleanPool == 0 then
        return 0
    end
    local added = 0
    local targets = {}

    -- 1. Реальные боты в workspace
    for name, bot in pairs(FakePlayers) do
        if bot and bot.Parent then
            table.insert(targets, name)
        end
    end

    -- 2. Фейки в лидерборде (без бота в workspace)
    for name, frame in pairs(fakePlayerFrames) do
        if frame and frame.Parent and not FakePlayers[name] then
            table.insert(targets, name)
