local function findFirstDescendantGlobal(parent, name)
    for _, child in ipairs(parent:GetDescendants()) do
        if child.Name == name then return child end
    end
    return nil
end

local function forceHideRealTradeWindows()
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return end
    local tradeRequest = findFirstDescendantGlobal(pg, "TradeRequest")
    if not tradeRequest then return end
    local receiving = tradeRequest:FindFirstChild("ReceivingRequest")
    if receiving then
        pcall(function() receiving.Visible = false end)
        for _, btn in ipairs(receiving:GetDescendants()) do
            if btn:IsA("TextButton") and (btn.Name == "Decline" or btn.Name == "Reject" or btn.Name == "Cancel") then
                pcall(function() btn:Activate() end)
            end
        end
    end
    local sending = tradeRequest:FindFirstChild("SendingRequest")
    if sending then
        local nameLbl = sending:FindFirstChild("Username")
        local displayedName = nameLbl and nameLbl.Text or ""
        if CurrentTradeMode == "fake" and ExpectedPartnerName and displayedName ~= "" and displayedName ~= ExpectedPartnerName then
            pcall(function() sending.Visible = false end)
            for _, btn in ipairs(sending:GetDescendants()) do
                if btn:IsA("TextButton") and (btn.Name == "Cancel" or btn.Name == "Decline") then
                    pcall(function() btn:Activate() end)
                end
            end
        end
    end
    local sendingVisible = sending and sending.Visible and ExpectedPartnerName
    local receivingVisible = receiving and receiving.Visible
    if not sendingVisible and not receivingVisible then
        pcall(function() tradeRequest.Visible = false end)
    end
end

local function SetFakeTradeLock(state, expectedName)
    FakeTradeLock = state
    if state then
        ExpectedPartnerName = expectedName
        CurrentTradeMode = "fake"
        forceHideRealTradeWindows()
    else
        ExpectedPartnerName = nil
        CurrentTradeMode = "real"
        if FakeTradeLockTimeout then pcall(function() task.cancel(FakeTradeLockTimeout) end); FakeTradeLockTimeout = nil end
    end
end

local function SetFakeTradeLockWithTimeout(seconds, expectedName)
    SetFakeTradeLock(true, expectedName)
    FakeTradeLockToken = FakeTradeLockToken + 1
    local myToken = FakeTradeLockToken
    if FakeTradeLockTimeout then pcall(function() task.cancel(FakeTradeLockTimeout) end); FakeTradeLockTimeout = nil end
    FakeTradeLockTimeout = task.delay(seconds, function()
        if FakeTradeLockToken == myToken and FakeTradeLock then SetFakeTradeLock(false) end
    end)
end

